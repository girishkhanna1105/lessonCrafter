# ==========================================
# LessonCrafter Environment Configuration
# ==========================================

# --- Supabase Database & Auth ---
# Obtain from your Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# --- AI Providers ---
# Google Gemini API key for Content, Interactive, Compiler, and UI Polish agents
# https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Groq API key for Quiz Designer & fast Socratic reasoning models
# https://console.groq.com/
GROQ_API_KEY=your-groq-api-key

# --- Security & JWT ---
# Strong secret used to sign and verify user authentication tokens
JWT_SECRET=your-random-jwt-secret-string

# --- Observability (Optional) ---
# Langfuse LLM monitoring and latency tracing
# https://langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
